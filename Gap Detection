import { LocationData, getScoreColor } from "../data/locations";

interface GapDetectionProps {
  data: LocationData;
}

export default function GapDetection({ data }: GapDetectionProps) {
  return (
    <section className="section-pad px-4 sm:px-6" style={{ background: "#020c1a" }}>
      <div className="max-w-7xl mx-auto">
        <div className="mb-10">
          <span className="tag-prototype" style={{ background: "rgba(255,68,68,0.1)", borderColor: "rgba(255,68,68,0.3)", color: "#ff6666" }}>
            ⚠ Gap Detection
          </span>
          <h2 className="font-display font-800 text-2xl sm:text-3xl mt-3" style={{ color: "#e8f4ff", fontWeight: 800 }}>
            Connectivity Gap Detection
          </h2>
          <p style={{ color: "#7090b0", marginTop: "0.5rem" }}>
            Areas with consistently poor connectivity identified in {data.name}.
          </p>
        </div>

        {data.gaps.length === 0 ? (
          <div className="glass rounded-2xl p-8 text-center">
            <div className="text-4xl mb-3">✅</div>
            <div className="font-display font-700" style={{ color: "#00e676" }}>No Significant Gaps Detected</div>
            <p style={{ color: "#7090b0", fontSize: "0.85rem", marginTop: "0.5rem" }}>
              Connectivity appears uniform across {data.name}.
            </p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {data.gaps.map((gap, i) => {
              const color = getScoreColor(gap.score);
              return (
                <div
                  key={i}
                  className="rounded-2xl p-6"
                  style={{
                    background: "rgba(255,68,68,0.04)",
                    border: "1px solid rgba(255,68,68,0.18)",
                  }}
                >
                  <div className="flex items-start justify-between mb-4">
                    <div>
                      <div style={{ color: "#ff6666", fontSize: "0.7rem", fontFamily: "var(--font-mono)", textTransform: "uppercase", letterSpacing: "0.08em", marginBottom: "0.4rem" }}>
                        ⚠ Connectivity Gap Detected
                      </div>
                      <div className="font-display font-700 text-lg" style={{ color: "#e8f4ff" }}>{gap.zone}</div>
                    </div>
                    <div
                      className="flex flex-col items-center justify-center rounded-xl p-3"
                      style={{ background: `${color}18`, border: `1px solid ${color}40`, minWidth: "70px" }}
                    >
                      <div className="font-mono-data font-700 text-xl" style={{ color }}>{gap.score}</div>
                      <div style={{ color: "#7090b0", fontSize: "0.62rem", fontFamily: "var(--font-mono)" }}>/100</div>
                    </div>
                  </div>

                  <div className="space-y-3">
                    <div className="flex gap-8">
                      <div>
                        <div style={{ color: "#5580a0", fontSize: "0.65rem", fontFamily: "var(--font-mono)", textTransform: "uppercase" }}>Network</div>
                        <div className="font-mono-data font-600 text-sm" style={{ color: "#00d4ff" }}>{gap.network}</div>
                      </div>
                      <div>
                        <div style={{ color: "#5580a0", fontSize: "0.65rem", fontFamily: "var(--font-mono)", textTransform: "uppercase" }}>Quality</div>
                        <div className="font-mono-data font-600 text-sm" style={{ color: "#ff6666" }}>Poor</div>
                      </div>
                    </div>

                    <div
                      className="rounded-lg p-3"
                      style={{ background: "rgba(255,68,68,0.06)", border: "1px solid rgba(255,68,68,0.12)" }}
                    >
                      <div style={{ color: "#ff8888", fontSize: "0.68rem", fontFamily: "var(--font-mono)", marginBottom: "0.25rem" }}>Problem Identified</div>
                      <div style={{ color: "#ffcccc", fontSize: "0.82rem" }}>{gap.problem}</div>
                    </div>

                    <div
                      className="rounded-lg p-3"
                      style={{ background: "rgba(0,212,255,0.04)", border: "1px solid rgba(0,212,255,0.12)" }}
                    >
                      <div style={{ color: "#00d4ff", fontSize: "0.68rem", fontFamily: "var(--font-mono)", marginBottom: "0.25rem" }}>AI Recommendation</div>
                      <div style={{ color: "#d0e8ff", fontSize: "0.82rem" }}>"{gap.recommendation}"</div>
                    </div>
                  </div>
                </div>
              );
            })}

            {/* Overall summary */}
            <div
              className="glass rounded-2xl p-6 md:col-span-2"
            >
              <h3 className="font-display font-600 text-sm mb-4" style={{ color: "#e8f4ff" }}>Gap Detection Summary — {data.name}</h3>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <SummaryCard label="Gaps Detected" value={data.gaps.length.toString()} color="#ff6666" />
                <SummaryCard label="Avg Gap Score" value={Math.round(data.gaps.reduce((s, g) => s + g.score, 0) / data.gaps.length) + "/100"} color="#ffbe00" />
                <SummaryCard label="Coverage" value={`${Math.round((1 - data.gaps.length / (data.heatmapPoints.length)) * 100)}%`} color="#00e676" />
                <SummaryCard label="Overall Score" value={`${data.score}/100`} color={getScoreColor(data.score)} />
              </div>
            </div>
          </div>
        )}
      </div>
    </section>
  );
}

function SummaryCard({ label, value, color }: { label: string; value: string; color: string }) {
  return (
    <div className="metric-card text-center">
      <div className="font-display font-700 text-2xl" style={{ color }}>{value}</div>
      <div style={{ color: "#5580a0", fontSize: "0.68rem", fontFamily: "var(--font-mono)", marginTop: "0.25rem" }}>{label}</div>
    </div>
  );
}
