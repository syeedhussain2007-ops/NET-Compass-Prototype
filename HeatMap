import { useState } from "react";
import { LocationData, HeatmapPoint, getHeatmapColor, getScoreLabel, getScoreColor } from "../data/locations";

interface HeatmapProps {
  data: LocationData;
}

export default function Heatmap({ data }: HeatmapProps) {
  const [selected, setSelected] = useState<HeatmapPoint | null>(null);
  const [networkFilter, setNetworkFilter] = useState("All");
  const [metricFilter, setMetricFilter] = useState("Connectivity Score");
  const [timeFilter, setTimeFilter] = useState("Live");
  const [layerFilter, setLayerFilter] = useState("Overall Connectivity Score");

  const filtered = data.heatmapPoints.filter((p) => {
    if (networkFilter !== "All" && p.network !== networkFilter) return false;
    return true;
  });

  return (
    <section id="heatmap" className="section-pad px-4 sm:px-6" style={{ background: "linear-gradient(180deg, #030f22 0%, #020c1a 100%)" }}>
      <div className="max-w-7xl mx-auto">
        <div className="mb-8">
          <span className="tag-prototype">◉ Heatmap View</span>
          <h2 className="font-display font-800 text-2xl sm:text-3xl mt-3" style={{ color: "#e8f4ff", fontWeight: 800 }}>
            Cellular Connectivity Heatmap
            <span style={{ color: "#5580a0", fontWeight: 400, fontSize: "1rem", marginLeft: "0.75rem" }}>— {data.name}</span>
          </h2>
          <p style={{ color: "#7090b0", marginTop: "0.5rem" }}>
            Spatial connectivity measurement distribution across {data.name}. Prototype Mode — Sample Data.
          </p>
        </div>

        {/* Filters */}
        <div className="glass rounded-xl p-4 mb-6 flex flex-wrap gap-4">
          <FilterGroup label="Network" options={["All", "4G", "5G"]} value={networkFilter} onChange={setNetworkFilter} />
          <FilterGroup label="Metric" options={["Connectivity Score", "Signal Strength", "Download Speed", "Upload Speed", "Latency"]} value={metricFilter} onChange={setMetricFilter} />
          <FilterGroup label="Time" options={["Live", "Today", "7 Days", "30 Days"]} value={timeFilter} onChange={setTimeFilter} />
          <FilterGroup label="Layer" options={["Signal Coverage", "Speed Coverage", "Latency Coverage", "Overall Connectivity Score"]} value={layerFilter} onChange={setLayerFilter} />
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Map */}
          <div className="lg:col-span-2">
            <div
              className="relative rounded-2xl overflow-hidden"
              style={{
                height: "460px",
                background: "linear-gradient(135deg, #061424 0%, #0a1f3a 50%, #061424 100%)",
                border: "1px solid rgba(0,212,255,0.12)",
              }}
            >
              {/* Grid lines */}
              <svg className="absolute inset-0 w-full h-full" style={{ opacity: 0.15 }}>
                {[10, 20, 30, 40, 50, 60, 70, 80, 90].map((p) => (
                  <g key={p}>
                    <line x1="0" y1={`${p}%`} x2="100%" y2={`${p}%`} stroke="#00d4ff" strokeWidth="0.5" />
                    <line x1={`${p}%`} y1="0" x2={`${p}%`} y2="100%" stroke="#00d4ff" strokeWidth="0.5" />
                  </g>
                ))}
              </svg>

              {/* Location label */}
              <div
                className="absolute top-4 left-4 px-3 py-1.5 rounded-lg"
                style={{ background: "rgba(2,12,26,0.85)", border: "1px solid rgba(0,212,255,0.2)" }}
              >
                <span style={{ color: "#00d4ff", fontFamily: "var(--font-mono)", fontSize: "0.72rem" }}>
                  📍 {data.name} Connectivity Map
                </span>
              </div>

              {/* Prototype badge */}
              <div className="absolute top-4 right-4">
                <span className="tag-prototype">Prototype — Sample Data</span>
              </div>

              {/* Heatmap blobs */}
              {filtered.map((p) => {
                const color = getHeatmapColor(p.score);
                return (
                  <div
                    key={p.id}
                    className="absolute rounded-full"
                    style={{
                      left: `${p.x}%`,
                      top: `${p.y}%`,
                      transform: "translate(-50%, -50%)",
                      width: "60px",
                      height: "60px",
                      background: color.replace("0.8", "0.15"),
                      filter: "blur(20px)",
                      pointerEvents: "none",
                    }}
                  />
                );
              })}

              {/* Points */}
              {filtered.map((p) => {
                const color = getHeatmapColor(p.score);
                const isSelected = selected?.id === p.id;
                return (
                  <button
                    key={p.id}
                    className="absolute rounded-full transition-transform"
                    style={{
                      left: `${p.x}%`,
                      top: `${p.y}%`,
                      transform: `translate(-50%, -50%) scale(${isSelected ? 1.4 : 1})`,
                      width: "14px",
                      height: "14px",
                      background: color,
                      boxShadow: `0 0 ${isSelected ? 16 : 8}px ${color}`,
                      border: isSelected ? "2px solid white" : "none",
                      cursor: "pointer",
                      zIndex: isSelected ? 10 : 5,
                    }}
                    onClick={() => setSelected(isSelected ? null : p)}
                    title={p.name}
                  />
                );
              })}

              {/* Popup */}
              {selected && (
                <div
                  className="absolute rounded-xl p-4 w-64"
                  style={{
                    left: Math.min(selected.x, 60) + "%",
                    top: Math.min(selected.y + 5, 70) + "%",
                    background: "rgba(2,12,26,0.97)",
                    border: "1px solid rgba(0,212,255,0.3)",
                    zIndex: 20,
                    boxShadow: "0 8px 32px rgba(0,0,0,0.6)",
                  }}
                >
                  <div className="flex justify-between items-start mb-3">
                    <div>
                      <div className="font-display font-700 text-sm" style={{ color: "#e8f4ff" }}>{selected.name}</div>
                      <div style={{ color: "#5580a0", fontSize: "0.68rem", fontFamily: "var(--font-mono)" }}>{selected.network} · {selected.timestamp}</div>
                    </div>
                    <button onClick={() => setSelected(null)} style={{ color: "#5580a0", fontSize: "1rem" }}>×</button>
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    {[
                      ["Score", `${selected.score}/100`],
                      ["Signal", `${selected.signal} dBm`],
                      ["Quality", `${selected.quality}%`],
                      ["Download", `${selected.download} Mbps`],
                      ["Upload", `${selected.upload} Mbps`],
                      ["Latency", `${selected.latency} ms`],
                    ].map(([k, v]) => (
                      <div key={k}>
                        <div style={{ color: "#5580a0", fontSize: "0.62rem", fontFamily: "var(--font-mono)" }}>{k}</div>
                        <div className="font-mono-data font-600 text-sm" style={{ color: getScoreColor(selected.score) }}>{v}</div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {/* Legend */}
            <div className="flex items-center gap-6 mt-4 flex-wrap">
              {[
                { color: "#00e676", label: "Excellent (80+)" },
                { color: "#ffbe00", label: "Good (60-79)" },
                { color: "#ff8800", label: "Moderate (40-59)" },
                { color: "#ff4444", label: "Poor (<40)" },
              ].map((l) => (
                <div key={l.label} className="flex items-center gap-2">
                  <div className="w-3 h-3 rounded-full" style={{ background: l.color, boxShadow: `0 0 6px ${l.color}` }} />
                  <span style={{ color: "#7090b0", fontSize: "0.72rem", fontFamily: "var(--font-mono)" }}>{l.label}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Points list */}
          <div className="space-y-3">
            <h3 className="font-display font-600 text-sm" style={{ color: "#e8f4ff" }}>Measurement Points</h3>
            {filtered.map((p) => {
              const color = getScoreColor(p.score);
              const isSelected = selected?.id === p.id;
              return (
                <button
                  key={p.id}
                  onClick={() => setSelected(isSelected ? null : p)}
                  className="w-full rounded-xl p-3 text-left transition-all"
                  style={{
                    background: isSelected ? "rgba(0,212,255,0.08)" : "rgba(10,31,58,0.5)",
                    border: `1px solid ${isSelected ? "rgba(0,212,255,0.3)" : "rgba(0,212,255,0.08)"}`,
                  }}
                >
                  <div className="flex items-center justify-between mb-1">
                    <span className="font-display font-600 text-sm" style={{ color: "#e8f4ff" }}>{p.name}</span>
                    <span
                      className="font-mono-data text-xs font-600"
                      style={{ color, background: `${color}18`, padding: "0.1rem 0.5rem", borderRadius: "4px" }}
                    >
                      {p.score}/100
                    </span>
                  </div>
                  <div className="flex gap-3" style={{ color: "#5580a0", fontSize: "0.68rem", fontFamily: "var(--font-mono)" }}>
                    <span>{p.network}</span>
                    <span>{p.download} Mbps ↓</span>
                    <span>{p.latency}ms</span>
                  </div>
                  <div className="progress-bar mt-2">
                    <div className="progress-fill" style={{ width: `${p.score}%`, background: color }} />
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  );
}

function FilterGroup({ label, options, value, onChange }: {
  label: string; options: string[]; value: string; onChange: (v: string) => void;
}) {
  return (
    <div className="flex items-center gap-2 flex-wrap">
      <span style={{ color: "#5580a0", fontSize: "0.7rem", fontFamily: "var(--font-mono)", textTransform: "uppercase" }}>{label}:</span>
      {options.map((o) => (
        <button
          key={o}
          onClick={() => onChange(o)}
          className="px-3 py-1 rounded-full text-xs transition-all"
          style={{
            background: value === o ? "rgba(0,212,255,0.15)" : "rgba(0,212,255,0.04)",
            border: `1px solid ${value === o ? "rgba(0,212,255,0.4)" : "rgba(0,212,255,0.08)"}`,
            color: value === o ? "#00d4ff" : "#5580a0",
            fontFamily: "var(--font-mono)",
          }}
        >
          {o}
        </button>
      ))}
    </div>
  );
}
