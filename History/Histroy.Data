import { useState } from "react";
import { LocationData, LOCATION_NAMES, LOCATIONS } from "../data/locations";
import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid } from "recharts";

interface HistoryProps {
  data: LocationData;
}

export default function History({ data }: HistoryProps) {
  const [timeFilter, setTimeFilter] = useState("7 Days");
  const [locFilter, setLocFilter] = useState("All Locations");

  // combine history across all locations or filter
  const allHistory = locFilter === "All Locations"
    ? Object.values(LOCATIONS).flatMap((l) => l.history).sort((a, b) => a.timestamp.localeCompare(b.timestamp))
    : LOCATIONS[locFilter]?.history || data.history;

  const timeCount = timeFilter === "Today" ? 4 : timeFilter === "7 Days" ? 14 : 30;
  const slicedHistory = allHistory.slice(-timeCount);

  const chartData = slicedHistory.map((h, i) => ({
    t: h.timestamp.slice(11, 16) || `T${i}`,
    score: h.score,
    download: h.download,
    latency: h.latency,
    signal: Math.abs(h.signal),
  }));

  const CustomTooltip = ({ active, payload, label }: any) => {
    if (!active || !payload?.length) return null;
    return (
      <div style={{ background: "rgba(2,12,26,0.97)", border: "1px solid rgba(0,212,255,0.2)", borderRadius: "10px", padding: "10px 14px" }}>
        <div style={{ color: "#5580a0", fontSize: "0.65rem", fontFamily: "var(--font-mono)", marginBottom: "4px" }}>{label}</div>
        {payload.map((p: any) => (
          <div key={p.name} style={{ color: p.color, fontSize: "0.75rem", fontFamily: "var(--font-mono)" }}>
            {p.name}: {p.value}
          </div>
        ))}
      </div>
    );
  };

  return (
    <section id="history" className="section-pad px-4 sm:px-6" style={{ background: "#020c1a" }}>
      <div className="max-w-7xl mx-auto">
        <div className="mb-8">
          <span className="tag-prototype">📊 History</span>
          <h2 className="font-display font-800 text-2xl sm:text-3xl mt-3" style={{ color: "#e8f4ff", fontWeight: 800 }}>
            Connectivity History
          </h2>
          <p style={{ color: "#7090b0", marginTop: "0.5rem" }}>
            Historical connectivity measurements across multiple locations.
          </p>
        </div>

        {/* Filters */}
        <div className="glass rounded-xl p-4 mb-8 flex flex-wrap gap-4 items-center">
          <div className="flex items-center gap-2 flex-wrap">
            <span style={{ color: "#5580a0", fontSize: "0.7rem", fontFamily: "var(--font-mono)", textTransform: "uppercase" }}>Time:</span>
            {["Today", "7 Days", "30 Days"].map((t) => (
              <button
                key={t}
                onClick={() => setTimeFilter(t)}
                className="px-3 py-1 rounded-full text-xs transition-all"
                style={{
                  background: timeFilter === t ? "rgba(0,212,255,0.15)" : "rgba(0,212,255,0.04)",
                  border: `1px solid ${timeFilter === t ? "rgba(0,212,255,0.4)" : "rgba(0,212,255,0.08)"}`,
                  color: timeFilter === t ? "#00d4ff" : "#5580a0",
                  fontFamily: "var(--font-mono)",
                }}
              >
                {t}
              </button>
            ))}
          </div>
          <div className="flex items-center gap-2 flex-wrap">
            <span style={{ color: "#5580a0", fontSize: "0.7rem", fontFamily: "var(--font-mono)", textTransform: "uppercase" }}>Location:</span>
            {["All Locations", ...LOCATION_NAMES].map((l) => (
              <button
                key={l}
                onClick={() => setLocFilter(l)}
                className="px-3 py-1 rounded-full text-xs transition-all"
                style={{
                  background: locFilter === l ? "rgba(0,212,255,0.15)" : "rgba(0,212,255,0.04)",
                  border: `1px solid ${locFilter === l ? "rgba(0,212,255,0.4)" : "rgba(0,212,255,0.08)"}`,
                  color: locFilter === l ? "#00d4ff" : "#5580a0",
                  fontFamily: "var(--font-mono)",
                }}
              >
                {l}
              </button>
            ))}
          </div>
        </div>

        {/* Charts */}
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
          <ChartCard title="Connectivity Score over Time" data={chartData} dataKey="score" color="#00d4ff" unit="/100" CustomTooltip={CustomTooltip} />
          <ChartCard title="Download Speed over Time" data={chartData} dataKey="download" color="#00e676" unit="Mbps" CustomTooltip={CustomTooltip} />
          <ChartCard title="Latency over Time" data={chartData} dataKey="latency" color="#ffbe00" unit="ms" CustomTooltip={CustomTooltip} />
          <ChartCard title="Signal Strength over Time" data={chartData} dataKey="signal" color="#ff8800" unit="dBm" CustomTooltip={CustomTooltip} />
        </div>

        {/* Table */}
        <div className="glass rounded-2xl overflow-hidden">
          <div className="p-4 border-b" style={{ borderColor: "rgba(0,212,255,0.08)" }}>
            <h3 className="font-display font-600 text-sm" style={{ color: "#e8f4ff" }}>
              Measurement Log ({slicedHistory.length} entries)
            </h3>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full" style={{ minWidth: "800px" }}>
              <thead>
                <tr style={{ borderBottom: "1px solid rgba(0,212,255,0.08)" }}>
                  {["Timestamp", "Location", "Dir", "Network", "Signal", "Download", "Upload", "Latency", "Score", "Reliability"].map((h) => (
                    <th
                      key={h}
                      className="px-4 py-2 text-left"
                      style={{ color: "#5580a0", fontSize: "0.65rem", fontFamily: "var(--font-mono)", textTransform: "uppercase", letterSpacing: "0.05em", fontWeight: 500 }}
                    >
                      {h}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {slicedHistory.slice(-10).reverse().map((h, i) => {
                  const sc = h.score >= 80 ? "#00e676" : h.score >= 60 ? "#ffbe00" : "#ff4444";
                  return (
                    <tr
                      key={i}
                      style={{ borderBottom: "1px solid rgba(0,212,255,0.04)" }}
                      onMouseEnter={(e) => { (e.currentTarget as HTMLTableRowElement).style.background = "rgba(0,212,255,0.03)"; }}
                      onMouseLeave={(e) => { (e.currentTarget as HTMLTableRowElement).style.background = "transparent"; }}
                    >
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#5580a0" }}>{h.timestamp}</td>
                      <td className="px-4 py-2 font-display text-sm font-500" style={{ color: "#e8f4ff" }}>{h.location}</td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#00d4ff" }}>{h.direction}</td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#00d4ff" }}>{h.network}</td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#7090b0" }}>{h.signal} dBm</td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#00e676" }}>{h.download} Mbps</td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#00e676" }}>{h.upload} Mbps</td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#ffbe00" }}>{h.latency} ms</td>
                      <td className="px-4 py-2">
                        <span className="font-mono-data text-xs font-700" style={{ color: sc }}>{h.score}</span>
                      </td>
                      <td className="px-4 py-2 font-mono-data text-xs" style={{ color: "#7090b0" }}>{h.reliability}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>
  );
}

function ChartCard({ title, data, dataKey, color, unit, CustomTooltip }: {
  title: string; data: any[]; dataKey: string; color: string; unit: string; CustomTooltip: any;
}) {
  return (
    <div className="glass rounded-2xl p-5">
      <div className="font-display font-600 text-sm mb-4" style={{ color: "#e8f4ff" }}>{title}</div>
      <ResponsiveContainer width="100%" height={160}>
        <LineChart data={data}>
          <CartesianGrid stroke="rgba(0,212,255,0.05)" strokeDasharray="4 4" />
          <XAxis dataKey="t" tick={{ fill: "#5580a0", fontSize: 10, fontFamily: "var(--font-mono)" }} axisLine={false} tickLine={false} />
          <YAxis tick={{ fill: "#5580a0", fontSize: 10, fontFamily: "var(--font-mono)" }} axisLine={false} tickLine={false} width={32} />
          <Tooltip content={<CustomTooltip />} />
          <Line type="monotone" dataKey={dataKey} stroke={color} strokeWidth={2} dot={false} />
        </LineChart>
      </ResponsiveContainer>
    </div>
  );
}
